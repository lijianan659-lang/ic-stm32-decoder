{
  "name": "ic-stm32-decoder",
  "version": "1.3.0",
  "description": "Zero-dependency IC top marking & SMD code lookup, YYWW/Julian/onsemi/NSC date code decoder, and datasheet-backed STM32 part number decoder (Node.js ESM + Python 3).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./date-code": "./src/date-code.js",
    "./stm32": "./src/stm32.js",
    "./top-marking": "./src/top-marking.js"
  },
  "bin": {
    "ic-stm32-decoder": "./bin/ic-stm32-decoder.js"
  },
  "files": [
    "bin/",
    "src/",
    "ic_stm32_decoder/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/node.test.js",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:all": "node --test tests/node.test.js && python3 -m unittest discover -s tests -p 'test_*.py' -v"
  },
  "homepage": "https://www.partvane.com/tools/",
  "keywords": [
    "top-marking",
    "smd-marking",
    "ic-marking",
    "ic-date-code",
    "date-code-decoder",
    "yyww",
    "wwyy",
    "julian-date",
    "onsemi",
    "and8002",
    "national-semiconductor",
    "snoa039c",
    "stm32",
    "stm32-decoder",
    "part-number-decoder",
    "electronic-components",
    "iqc",
    "bom"
  ],
  "author": "PartVane Engineering <sales@partvane.com> (https://www.partvane.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijianan659-lang/ic-stm32-decoder.git"
  },
  "bugs": {
    "url": "https://github.com/lijianan659-lang/ic-stm32-decoder/issues"
  }
}